<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400" prefWidth="600" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ec.edu.espoch.analisispendiente.controller.SecondaryController">

    <children>
        <VBox alignment="TOP_CENTER" spacing="10" style="-fx-background-color: skyblue;" stylesheets="@style.css" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
            
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" stylesheets="@style.css" text="Cálculo Detallado de la Función">
            <font>
               <Font name="System Bold Italic" size="20.0" />
            </font></Label>
            
            <TextArea fx:id="txtCalculo" editable="false" prefHeight="250" style="-fx-background-color: deepskyblue;" stylesheets="@style.css" wrapText="true" />
            
            <Button onAction="#volverAPrimary" prefWidth="150" styleClass="btn-action" text="Volver" />
        </VBox>
    </children>
</AnchorPane>
