<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ec.edu.espoch.analisispendiente.controller.PrimaryController">

    <children>
        <VBox alignment="TOP_CENTER" spacing="10" style="-fx-background-color: skyblue;" stylesheets="@style.css" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
            
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            
            <Label styleClass="title-label" text="Análisis de Funciones">
            <font>
               <Font name="System Bold Italic" size="20.0" />
            </font></Label>
            
            <ComboBox fx:id="cbTipoFuncion" prefWidth="300" promptText="Seleccione tipo de función" />
            
            <TextField fx:id="txtA" prefWidth="300" promptText="Ingrese el valor de a" />
            <TextField fx:id="txtB" prefWidth="300" promptText="Ingrese el valor de b" />
            <TextField fx:id="txtC" prefWidth="300" promptText="Ingrese el valor de c" />
            
            <Button onAction="#analizarFuncion" prefWidth="150" styleClass="btn-action" text="Calcular" />
            <Button onAction="#verCalculo" prefWidth="200" styleClass="btn-action" text="Ver Cálculo Detallado" />
            <Button onAction="#limpiar" prefWidth="150" styleClass="btn-clear" text="Limpiar" />
            
            <TextArea fx:id="txtAnalisis" prefHeight="150" prefWidth="500" wrapText="true" />
        </VBox>
    </children>
</AnchorPane>
