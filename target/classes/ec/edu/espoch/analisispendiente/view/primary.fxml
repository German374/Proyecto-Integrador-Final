<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="ec.edu.espoch.analisispendiente.controller.PrimaryController">

    <children>
        <VBox spacing="10" alignment="TOP_CENTER" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="Análisis de Fuciones" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            
            <ComboBox fx:id="cbTipoFuncion" promptText="Seleccione tipo de función" prefWidth="300"/>
            
            <TextField fx:id="txtA" promptText="Ingrese a" prefWidth="300"/>
            <TextField fx:id="txtB" promptText="Ingrese b" prefWidth="300"/>
            <TextField fx:id="txtC" promptText="Ingrese c" prefWidth="300"/>
            
            <Button text="Calcular" onAction="#analizarFuncion" prefWidth="150"/>
            <Button text="Ver Cálculo Detallado" onAction="#verCalculo" prefWidth="200"/>
            <Button text="Limpiar" onAction="#limpiar" prefWidth="150"/>
            
            <TextArea fx:id="txtAnalisis" wrapText="true" prefHeight="150" prefWidth="500"/>
        </VBox>
    </children>
</AnchorPane>












